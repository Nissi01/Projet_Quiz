# Copier ce fichier en backend/.env et remplacer les valeurs.
# backend/.env est ignoré par git : ne jamais y committer de vrais secrets.
# En production, on peut aussi définir ces variables directement dans l'environnement.

# Obligatoire : clé de signature des JWT, au moins 32 caractères aléatoires.
# Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-48-caracteres

# Obligatoire : mot de passe du compte admin créé au premier démarrage (au moins 12 caractères).
ADMIN_PASSWORD=remplace-moi-mot-de-passe-admin

# Optionnels (valeurs par défaut entre parenthèses)
# ADMIN_USERNAME=admin                    (admin)
# ADMIN_EMAIL=admin@studyquiz.local       (admin@studyquiz.local)
# JWT_EXPIRATION=PT24H                    (24 heures, format ISO-8601)
# DB_URL=jdbc:postgresql://localhost:5432/studyquiz
# DB_USER=studyquiz
# DB_PASSWORD=studyquiz_dev
# CORS_ORIGIN=http://localhost:5173
# IMPORT_SEED=true
